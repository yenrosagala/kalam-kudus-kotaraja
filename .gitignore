# dependencies
node_modules/

# sisa runtime lokal dari versi SQLite lama (server.js/db.js sudah dihapus).
# Polanya tetap diabaikan: file ini berisi data nyata, jangan pernah di-commit.
data/*.sqlite*
data/backups/

# sumber data.import berisi ~180 nama asli parishioner/pastor.
# Repo ini public. Impor lewat admin page, jangan lewat file ini.
jadwal ibadah.xlsx
Tabel informasi jemaat.xlsx

# lock file Excel:~$... muncul kalau workbook masih dibuka di Excel
~$*.xlsx

# hasil konversi workbook jadwal -> SQL: memuat nama yang sama, jadi sama
# perlakuan dengan xlsx. Jangan pernah di-commit; tempel ke Supabase lalu hapus.
jadwal-import.sql

