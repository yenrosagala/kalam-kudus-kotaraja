# dependencies
node_modules/

# sisa runtime lokal dari versi SQLite lama (server.js/db.js sudah dihapus).
# Polanya tetap diabaikan: file ini berisi data nyata, jangan pernah di-commit.
data/*.sqlite*
data/backups/

# sumber data: workbook apa pun bisa memuat ~180 nama asli parishioner/pastor.
# Repo ini public. Impor lewat admin page atau tempel SQL, jangan lewat file ini.
# Pola umum (bukan daftar nama file) supaya workbook baru otomatis ikut aman.
*.xlsx

# hasil konversi workbook -> SQL: memuat nama yang sama, jadi sama
# perlakuan dengan xlsx. Jangan pernah di-commit; tempel ke Supabase lalu hapus.
*-import.sql

# secrets
.env
.env.*

# OS & editor cruft
.DS_Store
Thumbs.db
*.swp